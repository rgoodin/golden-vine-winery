{
  "name": "integration-service",
  "version": "0.1.0",
  "private": true,
  "description": "Salesforce -> ServiceNow integration service (Golden Vine Winery)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "TS_NODE_PROJECT=tsconfig.test.json node --require ts-node/register/transpile-only --test \"test/**/*.test.ts\"",
    "dev": "ts-node src/index.ts",
    "start": "node -r ts-node/register/transpile-only dist/index.js",
    "publish-test-event": "ts-node scripts/publish-test-event.ts",
    "create-platform-event-fields": "ts-node scripts/create-platform-event-fields.ts",
    "verify-recent-incidents": "ts-node scripts/verify-recent-incidents.ts",
    "get-topic-info": "ts-node scripts/get-topic-info.ts",
    "detect-unprocessed-events": "ts-node scripts/detect-unprocessed-events.ts",
    "test-servicenow-concurrent-idempotency": "ts-node scripts/test-servicenow-concurrent-idempotency.ts",
    "test-durable-state-concurrent-idempotency": "ts-node scripts/test-durable-state-concurrent-idempotency.ts",
    "test-durable-state-crash-gap": "ts-node scripts/test-durable-state-crash-gap.ts",
    "test-durable-state-reclaim-ambiguity": "ts-node scripts/test-durable-state-reclaim-ambiguity.ts",
    "test-durable-state-reclaim-reconciliation": "ts-node scripts/test-durable-state-reclaim-reconciliation.ts",
    "test-durable-state-slow-worker-race": "ts-node scripts/test-durable-state-slow-worker-race.ts",
    "test-servicenow-conditional-create": "ts-node scripts/test-servicenow-conditional-create.ts",
    "test-production-concurrent-idempotency": "ts-node scripts/test-production-concurrent-idempotency.ts",
    "test-production-recovery": "ts-node scripts/test-production-recovery.ts",
    "test-recovery-payload-source": "ts-node scripts/test-recovery-payload-source.ts",
    "test-audit-recovery-composition": "ts-node scripts/test-audit-recovery-composition.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "golden-path-reliability": "*",
    "golden-path-salesforce-transport": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
