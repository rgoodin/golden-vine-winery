# Salesforce Pub/Sub API connection, via JWT bearer flow (see
# docs/decisions/0001-integration-architecture.md and
# docs/devex/friction-log.md FL-0001/FL-0002).
SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_USERNAME=
# Path to the private key matching the .crt uploaded to the External Client
# App's JWT Bearer certificate. Never commit this file - see .gitignore.
SALESFORCE_JWT_PRIVATE_KEY_PATH=./certs/server.key
# Fixed per environment type - production/Developer Edition orgs use
# login.salesforce.com; sandboxes use test.salesforce.com.
SALESFORCE_JWT_AUDIENCE=https://login.salesforce.com
SALESFORCE_PUBSUB_HOST=api.pubsub.salesforce.com:7443
# Salesforce auto-generates the API name from the Label with underscores
# between words - check the actual API Name on the Platform Event's detail
# page rather than assuming PascalCase (see friction-log.md FL-0006).
SALESFORCE_PUBSUB_TOPIC=/event/Distributor_Onboarding_Requested__e

# ServiceNow, via OAuth 2.0 Client Credentials grant (see
# docs/decisions/0004-servicenow-authentication.md). The token endpoint is
# always <instance>/oauth_token.do.
SERVICENOW_INSTANCE_URL=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
