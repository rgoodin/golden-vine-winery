# Salesforce Pub/Sub API connection, via JWT bearer flow - the SAME
# Salesforce org, External Client App, and running user as
# services/integration-service (see docs/decisions/0001-integration-architecture.md,
# docs/runbooks/salesforce-non-interactive-auth-setup.md). This service
# runs its own independent Pub/Sub subscription against the same topic -
# Salesforce Pub/Sub broadcasts each event to every independent
# subscriber, so no coordination with integration-service is needed.
SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_USERNAME=
# Path to the private key matching the .crt uploaded to the External
# Client App's JWT Bearer certificate. This is a copy of the same key
# integration-service uses (same Salesforce org credential) - never
# commit this file, see .gitignore.
SALESFORCE_JWT_PRIVATE_KEY_PATH=./certs/server.key
SALESFORCE_JWT_AUDIENCE=https://login.salesforce.com
SALESFORCE_PUBSUB_HOST=api.pubsub.salesforce.com:7443
SALESFORCE_PUBSUB_TOPIC=/event/Distributor_Onboarding_Requested__e

# Microsoft Graph / SharePoint, via an Azure AD app registration, OAuth
# 2.0 Client Credentials grant, Sites.Selected permission (see
# docs/decisions/0008-sharepoint-authentication.md and
# docs/runbooks/sharepoint-non-interactive-auth-setup.md). Token
# endpoint is always
# https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Graph's composite site ID: <hostname>,<site-collection-id>,<web-id> -
# see the runbook for how to derive it. Not the SharePoint site URL.
SHAREPOINT_SITE_ID=
# Folder under the site's default Documents library that distributor
# folders are created inside. Created on demand if it does not exist.
SHAREPOINT_WORKSPACE_FOLDER=Distributor Workspaces
